# Copy this file to ".env" in the server/ folder and fill in real values.
# NEVER commit the real ".env" file - it's already in .gitignore.

# A long random string used to sign the application JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# From your GitHub OAuth App (github.com/settings/developers -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must exactly match the "Authorization callback URL" set on the GitHub OAuth App.
# Localhost example:
GITHUB_CALLBACK_URL = https://ai-capsule-xxxx.onrender.com/auth/github/callback

PORT=5001
NODE_ENV=development